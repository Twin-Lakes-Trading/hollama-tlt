<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Template for the Scipio UI launch agent. deploy/install.sh fills in the
	__PLACEHOLDERS__ and writes the result to ~/Library/LaunchAgents.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.tlt.scipio-ui</string>
	<key>ProgramArguments</key>
	<array>
		<string>__NODE__</string>
		<string>__APP_DIR__/build/index.js</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__APP_DIR__</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOST</key>
		<string>__BIND_ADDRESS__</string>
		<key>PORT</key>
		<string>__PORT__</string>
		<key>PUBLIC_ADAPTER</key>
		<string>docker-node</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__LOG__</string>
	<key>StandardErrorPath</key>
	<string>__LOG__</string>
</dict>
</plist>
